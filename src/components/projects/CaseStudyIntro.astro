---
interface Props {
  index: string;
  title: string;
}

const { index, title } = Astro.props;
---

<div class="case-intro" aria-hidden="true">
  <div class="case-intro__content">
    <p class="case-intro__eyebrow">
      {index} / Case study
    </p>

    <p class="case-intro__title">
      {title}
    </p>

    <div class="case-intro__line"></div>
  </div>
</div>

<style>
  .case-intro {
    position: fixed;
    inset: 0;
    z-index: 9999;

    display: flex;
    align-items: center;
    justify-content: center;

    background: var(--color-background);
    pointer-events: none;

    animation: case-intro-reveal 1s
      cubic-bezier(0.76, 0, 0.24, 1) forwards;
  }

  .case-intro__content {
    width: min(calc(100% - 3rem), 64rem);

    animation: case-intro-content 600ms
      cubic-bezier(0.22, 1, 0.36, 1) forwards;
  }

  .case-intro__eyebrow {
    margin: 0 0 1rem;

    color: var(--color-accent);

    font-size: 0.75rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.25em;
  }

  .case-intro__title {
    margin: 0;

    color: var(--color-foreground);

    font-size: clamp(3rem, 10vw, 8rem);
    font-weight: 600;
    line-height: 0.9;
    letter-spacing: -0.055em;
    text-transform: uppercase;
  }

  .case-intro__line {
    width: 100%;
    height: 1px;
    margin-top: 2rem;

    background: var(--color-border);

    transform: scaleX(0);
    transform-origin: left;

    animation: case-intro-line 500ms
      100ms
      cubic-bezier(0.22, 1, 0.36, 1)
      forwards;
  }

  @keyframes case-intro-content {
    from {
      opacity: 0;
      transform: translateY(20px);
    }

    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes case-intro-line {
    from {
      transform: scaleX(0);
    }

    to {
      transform: scaleX(1);
    }
  }

  @keyframes case-intro-reveal {
    0%,
    58% {
      transform: translateY(0);
    }

    100% {
      transform: translateY(-100%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .case-intro {
      display: none;
    }
  }
</style>