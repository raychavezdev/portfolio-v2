---
import Reveal from "../animations/Reveal";
---

<Reveal client:visible y={24}>
  <section id="contacto" class="section-spacing pb-8">
    <div class="page-container">
      <div
        class="relative overflow-hidden rounded-3xl border border-border bg-surface/40 px-6 py-16 sm:px-10 md:py-24 lg:px-16"
      >
        <!-- Decorative glow -->
        <div
          class="pointer-events-none absolute -right-32 -top-32 size-96 rounded-full bg-accent/5 blur-3xl"
          aria-hidden="true"
        >
        </div>

        <!-- Decorative lines -->
        <div
          class="pointer-events-none absolute right-8 top-8 hidden items-center gap-2 md:flex"
          aria-hidden="true"
        >
          <span class="h-px w-10 bg-border"></span>
          <span class="size-1.5 rounded-full bg-accent"></span>
          <span
            class="font-mono text-[10px] uppercase tracking-[0.2em] text-muted"
          >
            Disponible
          </span>
        </div>

        <div class="relative">
          <p
            class="mb-6 text-sm font-medium uppercase tracking-[0.3em] text-accent"
          >
            06 / Contacto
          </p>

          <h2
            class="max-w-4xl text-5xl font-semibold leading-[0.95] tracking-tighter text-foreground sm:text-6xl md:text-7xl lg:text-8xl"
          >
            ¿Construimos algo
            <span class="block text-muted">juntos?</span>
          </h2>

          <p class="mt-8 max-w-2xl text-base leading-7 text-muted sm:text-lg">
            Estoy abierto a nuevas oportunidades como desarrollador web,
            colaboraciones y proyectos donde pueda aportar, aprender y seguir
            construyendo productos que generen valor.
          </p>

          <div class="mt-10 flex flex-wrap items-center gap-4">
            <a
              href="mailto:raymundo.developer@gmail.com"
              class="group inline-flex items-center gap-3 rounded-full bg-foreground px-6 py-3 text-sm font-medium text-background transition-all duration-300 hover:bg-accent"
            >
              Hablemos

              <span
                class="transition-transform duration-300 group-hover:-translate-y-0.5 group-hover:translate-x-0.5"
                aria-hidden="true"
              >
                ↗
              </span>
            </a>

            <a
              href="https://www.linkedin.com/in/raymundo-chavez/"
              target="_blank"
              rel="noreferrer"
              class="group inline-flex items-center gap-3 rounded-full border border-border bg-background/30 px-6 py-3 text-sm font-medium text-foreground transition-all duration-300 hover:border-accent/50 hover:bg-surface-light"
            >
              LinkedIn

              <span
                class="transition-transform duration-300 group-hover:-translate-y-0.5 group-hover:translate-x-0.5"
                aria-hidden="true"
              >
                ↗
              </span>
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>
</Reveal>
