---
import reactIcon from "../../assets/icons/tech/react.svg";
import astroIcon from "../../assets/icons/tech/astro.svg";
import typescriptIcon from "../../assets/icons/tech/typescript.svg";
import javascriptIcon from "../../assets/icons/tech/javascript.svg";
import tailwindIcon from "../../assets/icons/tech/tailwindcss.svg";

import djangoIcon from "../../assets/icons/tech/django.svg";
import pythonIcon from "../../assets/icons/tech/python.svg";
import laravelIcon from "../../assets/icons/tech/laravel.svg";
import phpIcon from "../../assets/icons/tech/php.svg";

import postgresqlIcon from "../../assets/icons/tech/postgresql.svg";
import mysqlIcon from "../../assets/icons/tech/mysql.svg";
import mongodbIcon from "../../assets/icons/tech/mongodb.svg";
import sqliteIcon from "../../assets/icons/tech/sqlite.svg";

import dockerIcon from "../../assets/icons/tech/docker.svg";
import linuxIcon from "../../assets/icons/tech/linux.svg";
import nginxIcon from "../../assets/icons/tech/nginx.svg";
import gunicornIcon from "../../assets/icons/tech/gunicorn.svg";
import vercelIcon from "../../assets/icons/tech/vercel.svg";
import gitIcon from "../../assets/icons/tech/git.svg";
import githubIcon from "../../assets/icons/tech/github.svg";
---

<section id="tecnologias" class="section-spacing">
  <div class="page-container">
    <!-- Header -->
    <div class="mb-16 md:mb-24">
      <p
        class="mb-4 text-sm font-medium uppercase tracking-[0.3em] text-accent"
      >
        04 / Tecnologías
      </p>

      <h2
        class="max-w-4xl text-4xl font-semibold tracking-[-0.04em] text-foreground sm:text-5xl md:text-6xl"
      >
        Un stack completo.
        <span class="block text-muted"> Una visión de principio a fin. </span>
      </h2>

      <p class="mt-6 max-w-2xl text-base leading-7 text-muted sm:text-lg">
        Desde la interfaz y la lógica de negocio hasta los datos y el
        despliegue, trabajo en las distintas capas que convierten una idea en
        una aplicación funcional.
      </p>
    </div>

    <!-- Technology grid -->
    <div class="grid gap-6 lg:grid-cols-12">
      <!-- Frontend -->
      <article class="tech-card lg:col-span-7">
        <p class="tech-card-index">01 / Frontend</p>

        <h3 class="tech-card-title">
          Interfaces rápidas,
          <span class="block text-muted">claras e interactivas.</span>
        </h3>

        <p class="tech-card-copy">
          Desarrollo experiencias web responsivas poniendo atención en
          rendimiento, accesibilidad y detalle visual.
        </p>

        <div class="mt-10 grid grid-cols-2 gap-3 sm:grid-cols-3">
          <div class="tech-item">
            <span class="tech-icon">
              <span
                class="tech-logo"
                style={`mask-image: url(${reactIcon.src}); -webkit-mask-image: url(${reactIcon.src});`}
                aria-hidden="true"></span>
            </span>
            <span>React</span>
          </div>

          <div class="tech-item">
            <span class="tech-icon">
              <span
                class="tech-logo"
                style={`mask-image: url(${astroIcon.src}); -webkit-mask-image: url(${astroIcon.src});`}
                aria-hidden="true"></span>
            </span>
            <span>Astro</span>
          </div>

          <div class="tech-item">
            <span class="tech-icon">
              <span
                class="tech-logo"
                style={`mask-image: url(${typescriptIcon.src}); -webkit-mask-image: url(${typescriptIcon.src});`}
                aria-hidden="true"></span>
            </span>
            <span>TypeScript</span>
          </div>

          <div class="tech-item">
            <span class="tech-icon">
              <span
                class="tech-logo"
                style={`mask-image: url(${javascriptIcon.src}); -webkit-mask-image: url(${javascriptIcon.src});`}
                aria-hidden="true"></span>
            </span>
            <span>JavaScript</span>
          </div>

          <div class="tech-item">
            <span class="tech-icon">
              <span
                class="tech-logo"
                style={`mask-image: url(${tailwindIcon.src}); -webkit-mask-image: url(${tailwindIcon.src});`}
                aria-hidden="true"></span>
            </span>
            <span>Tailwind CSS</span>
          </div>
        </div>
      </article>

      <!-- Backend -->
      <article class="tech-card lg:col-span-5">
        <p class="tech-card-index">02 / Backend</p>

        <h3 class="tech-card-title">
          Lógica de negocio
          <span class="block text-muted">y APIs.</span>
        </h3>

        <p class="tech-card-copy">
          Construyo backends orientados a reglas de negocio, persistencia,
          autenticación e integración entre servicios.
        </p>

        <div class="mt-10 grid grid-cols-2 gap-3">
          <div class="tech-item">
            <span class="tech-icon">
              <span
                class="tech-logo"
                style={`mask-image: url(${djangoIcon.src}); -webkit-mask-image: url(${djangoIcon.src});`}
                aria-hidden="true"></span>
            </span>
            <span>Django</span>
          </div>

          <div class="tech-item">
            <span class="tech-icon">
              <span
                class="tech-logo"
                style={`mask-image: url(${pythonIcon.src}); -webkit-mask-image: url(${pythonIcon.src});`}
                aria-hidden="true"></span>
            </span>
            <span>Python</span>
          </div>

          <div class="tech-item">
            <span class="tech-icon">
              <span
                class="tech-logo"
                style={`mask-image: url(${laravelIcon.src}); -webkit-mask-image: url(${laravelIcon.src});`}
                aria-hidden="true"></span>
            </span>
            <span>Laravel</span>
          </div>

          <div class="tech-item">
            <span class="tech-icon">
              <span
                class="tech-logo"
                style={`mask-image: url(${phpIcon.src}); -webkit-mask-image: url(${phpIcon.src});`}
                aria-hidden="true"></span>
            </span>
            <span>PHP</span>
          </div>
        </div>
      </article>

      <!-- Data -->
      <article class="tech-card lg:col-span-5">
        <p class="tech-card-index">03 / Datos</p>

        <h3 class="tech-card-title">
          Datos estructurados
          <span class="block text-muted">para productos reales.</span>
        </h3>

        <p class="tech-card-copy">
          Diseño y trabajo con modelos de datos adaptados a las necesidades de
          cada aplicación.
        </p>

        <div class="mt-10 grid grid-cols-2 gap-3">
          <div class="tech-item">
            <span class="tech-icon">
              <span
                class="tech-logo"
                style={`mask-image: url(${postgresqlIcon.src}); -webkit-mask-image: url(${postgresqlIcon.src});`}
                aria-hidden="true"></span>
            </span>
            <span>PostgreSQL</span>
          </div>

          <div class="tech-item">
            <span class="tech-icon">
              <span
                class="tech-logo"
                style={`mask-image: url(${mysqlIcon.src}); -webkit-mask-image: url(${mysqlIcon.src});`}
                aria-hidden="true"></span>
            </span>
            <span>MySQL</span>
          </div>

          <div class="tech-item">
            <span class="tech-icon">
              <span
                class="tech-logo"
                style={`mask-image: url(${mongodbIcon.src}); -webkit-mask-image: url(${mongodbIcon.src});`}
                aria-hidden="true"></span>
            </span>
            <span>MongoDB</span>
          </div>

          <div class="tech-item">
            <span class="tech-icon">
              <span
                class="tech-logo"
                style={`mask-image: url(${sqliteIcon.src}); -webkit-mask-image: url(${sqliteIcon.src});`}
                aria-hidden="true"></span>
            </span>
            <span>SQLite</span>
          </div>
        </div>
      </article>

      <!-- Infrastructure -->
      <article class="tech-card lg:col-span-7">
        <p class="tech-card-index">04 / Infraestructura &amp; workflow</p>

        <h3 class="tech-card-title">
          Del código
          <span class="block text-muted">al entorno de producción.</span>
        </h3>

        <p class="tech-card-copy">
          Trabajo también con las herramientas necesarias para versionar,
          desplegar, ejecutar y mantener aplicaciones fuera del entorno local.
        </p>

        <div class="mt-10 grid grid-cols-2 gap-3 sm:grid-cols-3">
          <div class="tech-item">
            <span class="tech-icon">
              <span
                class="tech-logo"
                style={`mask-image: url(${dockerIcon.src}); -webkit-mask-image: url(${dockerIcon.src});`}
                aria-hidden="true"></span>
            </span>
            <span>Docker</span>
          </div>

          <div class="tech-item">
            <span class="tech-icon">
              <span
                class="tech-logo"
                style={`mask-image: url(${linuxIcon.src}); -webkit-mask-image: url(${linuxIcon.src});`}
                aria-hidden="true"></span>
            </span>
            <span>Linux</span>
          </div>

          <div class="tech-item">
            <span class="tech-icon">
              <span
                class="tech-logo"
                style={`mask-image: url(${nginxIcon.src}); -webkit-mask-image: url(${nginxIcon.src});`}
                aria-hidden="true"></span>
            </span>
            <span>Nginx</span>
          </div>

          <div class="tech-item">
            <span class="tech-icon">
              <span
                class="tech-logo"
                style={`mask-image: url(${gunicornIcon.src}); -webkit-mask-image: url(${gunicornIcon.src});`}
                aria-hidden="true"></span>
            </span>
            <span>Gunicorn</span>
          </div>

          <div class="tech-item">
            <span class="tech-icon">
              <span
                class="tech-logo"
                style={`mask-image: url(${vercelIcon.src}); -webkit-mask-image: url(${vercelIcon.src});`}
                aria-hidden="true"></span>
            </span>
            <span>Vercel</span>
          </div>

          <div class="tech-item">
            <span class="tech-icon">
              <span
                class="tech-logo"
                style={`mask-image: url(${gitIcon.src}); -webkit-mask-image: url(${gitIcon.src});`}
                aria-hidden="true"></span>
            </span>
            <span>Git</span>
          </div>

          <div class="tech-item">
            <span class="tech-icon">
              <span
                class="tech-logo"
                style={`mask-image: url(${githubIcon.src}); -webkit-mask-image: url(${githubIcon.src});`}
                aria-hidden="true"></span>
            </span>
            <span>GitHub</span>
          </div>
        </div>
      </article>
    </div>
  </div>
</section>
