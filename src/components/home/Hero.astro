---
import HeroIntro from "../animations/HeroIntro";
---

<section class="relative flex min-h-screen items-center overflow-hidden pt-28">
  <div class="page-container relative z-10">
    <HeroIntro client:load />
  </div>

  <div class="pointer-events-none absolute inset-0" aria-hidden="true">
    <div class="pointer-events-none absolute inset-0" aria-hidden="true">
      <div
        class="hero-glow absolute left-[65%] top-[30%] size-112 rounded-full bg-accent/5 blur-[120px]"
      >
      </div>
    </div>
  </div>
</section>
