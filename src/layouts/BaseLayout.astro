---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Raymundo Chavez | Full-Stack Developer",
  description = "Portfolio de Raymundo Chavez, desarrollador full-stack especializado en crear aplicaciones web y soluciones de software para problemas reales.",
} = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />

    <meta name="description" content={description} />

    <title>{title}</title>
  </head>

  <body>
    <slot />
  </body>
</html>