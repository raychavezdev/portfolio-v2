---
import { Image } from "astro:assets";

import ProjectLayout from "../../layouts/ProjectLayout.astro";
import Reveal from "../../components/animations/Reveal";

import home from "../../assets/projects/dale-skate/home.png";
import panel from "../../assets/projects/dale-skate/panel.png";
import editor from "../../assets/projects/dale-skate/editor.png";
---

<ProjectLayout
  title="Dale Skate | Raymundo Chavez"
  description="Case study de Dale Skate, una revista física de skateboarding llevada a web mediante una plataforma full-stack con gestión editorial y panel de administración."
>
  <!-- Hero -->
  <section class="relative overflow-hidden pb-20 pt-40 md:pb-28 md:pt-48">
    <div class="page-container relative z-10">
      <Reveal client:load y={20}>
        <div>
          <div class="flex flex-wrap items-center gap-3">
            <span
              class="rounded-full border border-border bg-surface/40 px-3 py-1.5 text-xs uppercase tracking-[0.15em] text-muted"
            >
              Proyecto para cliente
            </span>

            <span class="text-sm text-muted">
              Case study
            </span>
          </div>

          <h1
            class="mt-8 max-w-5xl text-6xl font-semibold leading-[0.92] tracking-[-0.05em] text-foreground sm:text-7xl md:text-8xl lg:text-9xl"
          >
            Dale Skate
          </h1>

          <p
            class="mt-8 max-w-3xl text-xl leading-8 text-muted sm:text-2xl sm:leading-9"
          >
            De una revista física a una plataforma web editorial que permite
            publicar y administrar contenido sin depender de cambios en código.
          </p>

          <div class="mt-10 flex flex-wrap gap-3">
            <a
              href="https://daleskate.com/"
              target="_blank"
              rel="noreferrer"
              class="group inline-flex items-center gap-3 rounded-full bg-foreground px-6 py-3 text-sm font-medium text-background transition-all duration-300 hover:bg-accent"
            >
              Visitar sitio

              <span
                class="transition-transform duration-300 group-hover:-translate-y-0.5 group-hover:translate-x-0.5"
                aria-hidden="true"
              >
                ↗
              </span>
            </a>

            <a
              href="https://github.com/raychavezdev/daleskate"
              target="_blank"
              rel="noreferrer"
              class="group inline-flex items-center gap-3 rounded-full border border-border bg-surface/40 px-6 py-3 text-sm font-medium text-foreground transition-all duration-300 hover:border-accent/40 hover:bg-surface"
            >
              GitHub

              <span
                class="transition-transform duration-300 group-hover:-translate-y-0.5 group-hover:translate-x-0.5"
                aria-hidden="true"
              >
                ↗
              </span>
            </a>
          </div>
        </div>
      </Reveal>

      <!-- Project meta -->
      <Reveal client:load delay={0.05} y={20}>
        <div
          class="mt-16 grid gap-8 border-y border-border py-8 sm:grid-cols-2 lg:grid-cols-4"
        >
          <div>
            <p class="text-xs uppercase tracking-[0.2em] text-muted">
              Rol
            </p>

            <p class="mt-3 text-sm text-foreground">
              Full-Stack Development
            </p>
          </div>

          <div>
            <p class="text-xs uppercase tracking-[0.2em] text-muted">
              Tipo
            </p>

            <p class="mt-3 text-sm text-foreground">
              Proyecto para cliente
            </p>
          </div>

          <div>
            <p class="text-xs uppercase tracking-[0.2em] text-muted">
              Diseño
            </p>

            <p class="mt-3 text-sm text-foreground">
              Figma proporcionado por cliente
            </p>
          </div>

          <div>
            <p class="text-xs uppercase tracking-[0.2em] text-muted">
              Estado
            </p>

            <p class="mt-3 text-sm text-foreground">
              En producción
            </p>
          </div>
        </div>
      </Reveal>
    </div>

    <div
      class="pointer-events-none absolute left-[60%] top-[20%] size-112 rounded-full bg-accent/5 blur-[140px]"
      aria-hidden="true"
    >
    </div>
  </section>

  <!-- Hero screenshot -->
  <section>
    <div class="page-container">
      <Reveal client:visible y={24}>
        <div
          class="relative overflow-hidden rounded-3xl border border-border bg-surface p-3 sm:p-5"
        >
          <div
            class="overflow-hidden rounded-2xl border border-border bg-background"
          >
            <div
              class="flex h-11 items-center gap-2 border-b border-border px-4"
            >
              <span class="size-2 rounded-full bg-muted/30"></span>
              <span class="size-2 rounded-full bg-muted/30"></span>
              <span class="size-2 rounded-full bg-muted/30"></span>

              <span
                class="ml-3 text-[10px] uppercase tracking-[0.18em] text-muted"
              >
                Dale Skate / Sitio público
              </span>
            </div>

            <Image
              src={home}
              alt="Página pública de Dale Skate"
              class="w-full"
            />
          </div>
        </div>
      </Reveal>
    </div>
  </section>

  <!-- Context -->
  <section class="section-spacing">
    <div class="page-container">
      <Reveal client:visible>
        <div
          class="grid gap-10 border-t border-border pt-10 lg:grid-cols-[0.35fr_1fr] lg:gap-20"
        >
          <div>
            <p
              class="text-sm font-medium uppercase tracking-[0.25em] text-accent"
            >
              01 / Contexto
            </p>
          </div>

          <div class="max-w-3xl">
            <h2
              class="text-3xl font-semibold tracking-[-0.03em] text-foreground sm:text-4xl md:text-5xl"
            >
              Llevar una revista física de skateboarding al entorno web.
            </h2>

            <p class="mt-8 text-base leading-8 text-muted sm:text-lg">
              Dale Skate es una revista de skateboarding distribuida en formato
              físico. La dueña de la revista me contactó para desarrollar su
              presencia web y me proporcionó un diseño en Figma para definir la
              experiencia visual de la página principal.
            </p>

            <p class="mt-6 text-base leading-8 text-muted sm:text-lg">
              Mi trabajo comenzó implementando esa propuesta visual, pero durante
              el desarrollo apareció una necesidad importante: definir cómo se
              publicaría y mantendría el contenido después de lanzar el sitio.
            </p>
          </div>
        </div>
      </Reveal>
    </div>
  </section>

  <!-- Challenge -->
  <section class="pb-20 md:pb-28">
    <div class="page-container">
      <Reveal client:visible>
        <div
          class="grid gap-10 border-t border-border pt-10 lg:grid-cols-[0.35fr_1fr] lg:gap-20"
        >
          <div>
            <p
              class="text-sm font-medium uppercase tracking-[0.25em] text-accent"
            >
              02 / El reto
            </p>
          </div>

          <div class="max-w-3xl">
            <h2
              class="text-3xl font-semibold tracking-[-0.03em] text-foreground sm:text-4xl md:text-5xl"
            >
              Publicar contenido no debía depender permanentemente de un
              desarrollador.
            </h2>

            <p class="mt-8 text-base leading-8 text-muted sm:text-lg">
              Una opción inicial habría sido crear los artículos directamente
              desde código. Técnicamente funcionaba, pero significaba que cada
              nueva publicación requeriría modificar el proyecto y realizar un
              nuevo despliegue.
            </p>

            <p class="mt-6 text-base leading-8 text-muted sm:text-lg">
              Para una revista que necesita publicar contenido de forma
              recurrente, eso habría creado una dependencia constante de un
              desarrollador y convertido una tarea editorial en una tarea
              técnica.
            </p>
          </div>
        </div>
      </Reveal>
    </div>
  </section>

  <!-- Proposal -->
  <section class="pb-20 md:pb-28">
    <div class="page-container">
      <Reveal client:visible>
        <div
          class="grid gap-10 border-t border-border pt-10 lg:grid-cols-[0.35fr_1fr] lg:gap-20"
        >
          <div>
            <p
              class="text-sm font-medium uppercase tracking-[0.25em] text-accent"
            >
              03 / La propuesta
            </p>
          </div>

          <div class="max-w-3xl">
            <h2
              class="text-3xl font-semibold tracking-[-0.03em] text-foreground sm:text-4xl md:text-5xl"
            >
              Convertir el sitio en una plataforma administrable.
            </h2>

            <p class="mt-8 text-base leading-8 text-muted sm:text-lg">
              Propuse desarrollar un panel de administración para que la dueña
              pudiera crear, editar y publicar contenido directamente desde la
              plataforma, sin tener que solicitar cambios de código cada vez que
              necesitara agregar un artículo.
            </p>

            <p class="mt-6 text-base leading-8 text-muted sm:text-lg">
              Esa decisión amplió el alcance del proyecto: dejó de ser solamente
              la implementación de un sitio público y se convirtió en una
              plataforma editorial full-stack con herramientas propias para
              gestionar su contenido.
            </p>
          </div>
        </div>
      </Reveal>
    </div>
  </section>

  <!-- My role -->
  <section class="pb-20 md:pb-28">
    <div class="page-container">
      <Reveal client:visible>
        <div
          class="grid gap-10 border-t border-border pt-10 lg:grid-cols-[0.35fr_1fr] lg:gap-20"
        >
          <div>
            <p
              class="text-sm font-medium uppercase tracking-[0.25em] text-accent"
            >
              04 / Mi participación
            </p>
          </div>

          <div>
            <div class="max-w-3xl">
              <h2
                class="text-3xl font-semibold tracking-[-0.03em] text-foreground sm:text-4xl md:text-5xl"
              >
                Del diseño en Figma a una plataforma editorial funcional.
              </h2>

              <p class="mt-8 text-base leading-8 text-muted sm:text-lg">
                Implementé la experiencia pública a partir del diseño entregado
                por la cliente y desarrollé la lógica necesaria para convertirla
                en un sitio dinámico conectado con contenido administrable.
              </p>

              <p class="mt-6 text-base leading-8 text-muted sm:text-lg">
                También diseñé e implementé la parte administrativa, los
                endpoints del backend, la autenticación y las herramientas que
                permiten mantener la revista sin depender de cambios manuales en
                el código.
              </p>
            </div>

            <div class="mt-12 grid gap-4 md:grid-cols-3">
              <article
                class="rounded-3xl border border-border bg-surface/30 p-6"
              >
                <p class="text-xs uppercase tracking-[0.2em] text-accent">
                  01
                </p>

                <h3 class="mt-4 text-xl font-semibold text-foreground">
                  Implementación frontend
                </h3>

                <p class="mt-4 text-sm leading-7 text-muted">
                  Desarrollo de la experiencia pública a partir del diseño
                  definido en Figma.
                </p>
              </article>

              <article
                class="rounded-3xl border border-border bg-surface/30 p-6"
              >
                <p class="text-xs uppercase tracking-[0.2em] text-accent">
                  02
                </p>

                <h3 class="mt-4 text-xl font-semibold text-foreground">
                  Backend y datos
                </h3>

                <p class="mt-4 text-sm leading-7 text-muted">
                  Construcción de endpoints y lógica para almacenar, consultar y
                  administrar el contenido de la plataforma.
                </p>
              </article>

              <article
                class="rounded-3xl border border-border bg-surface/30 p-6"
              >
                <p class="text-xs uppercase tracking-[0.2em] text-accent">
                  03
                </p>

                <h3 class="mt-4 text-xl font-semibold text-foreground">
                  Producto y administración
                </h3>

                <p class="mt-4 text-sm leading-7 text-muted">
                  Propuesta y desarrollo del panel que permite a la cliente
                  administrar la revista de forma independiente.
                </p>
              </article>
            </div>
          </div>
        </div>
      </Reveal>
    </div>
  </section>

  <!-- Admin -->
  <section class="pb-28 md:pb-36">
    <div class="page-container">
      <div class="border-t border-border pt-10">
        <Reveal client:visible>
          <div
            class="grid gap-10 lg:grid-cols-[0.35fr_1fr] lg:gap-20"
          >
            <div>
              <p
                class="text-sm font-medium uppercase tracking-[0.25em] text-accent"
              >
                05 / Gestión editorial
              </p>
            </div>

            <div class="max-w-3xl">
              <h2
                class="text-3xl font-semibold tracking-[-0.03em] text-foreground sm:text-4xl md:text-5xl"
              >
                Convertir la publicación en una tarea editorial, no técnica.
              </h2>

              <p class="mt-8 text-base leading-8 text-muted sm:text-lg">
                Desde el panel de administración se puede gestionar el contenido
                publicado sin editar archivos del proyecto ni realizar un nuevo
                despliegue para cada actualización.
              </p>

              <p class="mt-6 text-base leading-8 text-muted sm:text-lg">
                Esto permite que la revista mantenga su propio ritmo de
                publicación y reduce la dependencia del desarrollador para las
                tareas habituales de contenido.
              </p>
            </div>
          </div>
        </Reveal>

        <Reveal client:visible y={24}>
          <div
            class="mt-16 overflow-hidden rounded-3xl border border-border bg-surface p-2 sm:p-3"
          >
            <Image
              src={panel}
              alt="Panel administrativo de Dale Skate"
              class="w-full rounded-2xl"
            />
          </div>
        </Reveal>
      </div>
    </div>
  </section>

  <!-- Editor -->
  <section class="pb-28 md:pb-36">
    <div class="page-container">
      <Reveal client:visible>
        <div
          class="grid gap-10 border-t border-border pt-10 lg:grid-cols-[0.35fr_1fr] lg:gap-20"
        >
          <div>
            <p
              class="text-sm font-medium uppercase tracking-[0.25em] text-accent"
            >
              06 / Editor
            </p>
          </div>

          <div class="max-w-3xl">
            <h2
              class="text-3xl font-semibold tracking-[-0.03em] text-foreground sm:text-4xl md:text-5xl"
            >
              Construir artículos visualmente desde la propia plataforma.
            </h2>

            <p class="mt-8 text-base leading-8 text-muted sm:text-lg">
              El editor permite combinar texto enriquecido, imágenes y videos
              dentro de una misma publicación y organizar esos elementos desde
              una interfaz pensada para contenido editorial.
            </p>

            <p class="mt-6 text-base leading-8 text-muted sm:text-lg">
              La previsualización permite revisar el resultado del artículo
              mientras se construye, acercando el proceso de edición a la forma
              en que finalmente se mostrará al lector.
            </p>
          </div>
        </div>
      </Reveal>

      <Reveal client:visible y={24}>
        <div
          class="mt-16 overflow-hidden rounded-3xl border border-border bg-surface p-2 sm:p-3"
        >
          <Image
            src={editor}
            alt="Editor y previsualización de artículos de Dale Skate"
            class="w-full rounded-2xl"
          />
        </div>
      </Reveal>
    </div>
  </section>

  <!-- Features -->
  <section class="pb-28 md:pb-36">
    <div class="page-container">
      <Reveal client:visible>
        <div
          class="grid gap-10 border-t border-border pt-10 lg:grid-cols-[0.35fr_1fr] lg:gap-20"
        >
          <div>
            <p
              class="text-sm font-medium uppercase tracking-[0.25em] text-accent"
            >
              07 / Funcionalidades
            </p>
          </div>

          <div>
            <h2
              class="max-w-3xl text-3xl font-semibold tracking-[-0.03em] text-foreground sm:text-4xl md:text-5xl"
            >
              Herramientas para gestionar más que artículos.
            </h2>

            <div class="mt-12 grid gap-4 sm:grid-cols-2">
              <article
                class="rounded-3xl border border-border bg-surface/30 p-6"
              >
                <p class="text-xs uppercase tracking-[0.2em] text-accent">
                  Artículos
                </p>

                <h3 class="mt-4 text-xl font-semibold text-foreground">
                  Gestión editorial
                </h3>

                <p class="mt-4 text-sm leading-7 text-muted">
                  Creación, edición y mantenimiento de publicaciones desde el
                  panel administrativo.
                </p>
              </article>

              <article
                class="rounded-3xl border border-border bg-surface/30 p-6"
              >
                <p class="text-xs uppercase tracking-[0.2em] text-accent">
                  Multimedia
                </p>

                <h3 class="mt-4 text-xl font-semibold text-foreground">
                  Texto, imágenes y video
                </h3>

                <p class="mt-4 text-sm leading-7 text-muted">
                  Composición de artículos utilizando distintos tipos de
                  contenido dentro de una misma publicación.
                </p>
              </article>

              <article
                class="rounded-3xl border border-border bg-surface/30 p-6"
              >
                <p class="text-xs uppercase tracking-[0.2em] text-accent">
                  Encuestas
                </p>

                <h3 class="mt-4 text-xl font-semibold text-foreground">
                  Participación de lectores
                </h3>

                <p class="mt-4 text-sm leading-7 text-muted">
                  Creación y administración de encuestas desde el mismo entorno.
                </p>
              </article>

              <article
                class="rounded-3xl border border-border bg-surface/30 p-6"
              >
                <p class="text-xs uppercase tracking-[0.2em] text-accent">
                  Publicidad
                </p>

                <h3 class="mt-4 text-xl font-semibold text-foreground">
                  Espacios administrables
                </h3>

                <p class="mt-4 text-sm leading-7 text-muted">
                  Gestión de elementos publicitarios sin necesidad de modificar
                  directamente el frontend.
                </p>
              </article>
            </div>
          </div>
        </div>
      </Reveal>
    </div>
  </section>

  <!-- Architecture -->
  <section class="pb-28 md:pb-36">
    <div class="page-container">
      <Reveal client:visible>
        <div
          class="grid gap-10 border-t border-border pt-10 lg:grid-cols-[0.35fr_1fr] lg:gap-20"
        >
          <div>
            <p
              class="text-sm font-medium uppercase tracking-[0.25em] text-accent"
            >
              08 / Arquitectura
            </p>
          </div>

          <div>
            <h2
              class="max-w-3xl text-3xl font-semibold tracking-[-0.03em] text-foreground sm:text-4xl md:text-5xl"
            >
              Una experiencia React conectada a un backend en PHP.
            </h2>

            <p class="mt-8 max-w-3xl text-base leading-8 text-muted sm:text-lg">
              El frontend consume endpoints desarrollados en PHP para obtener y
              modificar los recursos de la plataforma, mientras que las
              operaciones administrativas se protegen mediante autenticación
              basada en JWT.
            </p>

            <div class="mt-12 grid gap-4 md:grid-cols-3">
              <article
                class="rounded-3xl border border-border bg-surface/30 p-6"
              >
                <p class="text-xs uppercase tracking-[0.2em] text-accent">
                  Frontend
                </p>

                <h3 class="mt-4 text-xl font-semibold text-foreground">
                  React + Vite
                </h3>

                <p class="mt-4 text-sm leading-7 text-muted">
                  Implementación de la experiencia pública y las herramientas
                  administrativas.
                </p>
              </article>

              <article
                class="rounded-3xl border border-border bg-surface/30 p-6"
              >
                <p class="text-xs uppercase tracking-[0.2em] text-accent">
                  Backend
                </p>

                <h3 class="mt-4 text-xl font-semibold text-foreground">
                  PHP
                </h3>

                <p class="mt-4 text-sm leading-7 text-muted">
                  Endpoints y lógica de servidor para gestionar los recursos de
                  la revista.
                </p>
              </article>

              <article
                class="rounded-3xl border border-border bg-surface/30 p-6"
              >
                <p class="text-xs uppercase tracking-[0.2em] text-accent">
                  Seguridad
                </p>

                <h3 class="mt-4 text-xl font-semibold text-foreground">
                  JWT
                </h3>

                <p class="mt-4 text-sm leading-7 text-muted">
                  Protección de las operaciones disponibles dentro del panel
                  administrativo.
                </p>
              </article>
            </div>
          </div>
        </div>
      </Reveal>
    </div>
  </section>

  <!-- Stack -->
  <section class="pb-28 md:pb-36">
    <div class="page-container">
      <Reveal client:visible>
        <div
          class="grid gap-10 border-y border-border py-10 lg:grid-cols-[0.35fr_1fr] lg:gap-20"
        >
          <div>
            <p
              class="text-sm font-medium uppercase tracking-[0.25em] text-accent"
            >
              09 / Stack
            </p>
          </div>

          <div class="flex flex-wrap gap-3">
            <span class="tech-pill">React</span>
            <span class="tech-pill">Vite</span>
            <span class="tech-pill">Tailwind CSS</span>
            <span class="tech-pill">React Router</span>
            <span class="tech-pill">React Quill</span>
            <span class="tech-pill">DOMPurify</span>
            <span class="tech-pill">PHP</span>
            <span class="tech-pill">JWT</span>
          </div>
        </div>
      </Reveal>
    </div>
  </section>

  <!-- Result -->
  <section class="pb-32 md:pb-40">
    <div class="page-container">
      <Reveal client:visible>
        <div
          class="grid gap-10 border-y border-border py-12 lg:grid-cols-[0.35fr_1fr] lg:gap-20"
        >
          <div>
            <p
              class="text-sm font-medium uppercase tracking-[0.25em] text-accent"
            >
              10 / Resultado
            </p>
          </div>

          <div class="max-w-3xl">
            <h2
              class="text-3xl font-semibold tracking-[-0.03em] text-foreground sm:text-4xl md:text-5xl"
            >
              De una revista física a una plataforma web administrable.
            </h2>

            <p class="mt-8 text-base leading-8 text-muted sm:text-lg">
              El proyecto comenzó con el objetivo de trasladar Dale Skate a web
              a partir de un diseño en Figma y terminó convirtiéndose en una
              plataforma donde la publicación editorial está separada del
              desarrollo técnico.
            </p>

            <p class="mt-6 text-base leading-8 text-muted sm:text-lg">
              La revista cuenta ahora con una presencia digital pública y con
              herramientas internas que permiten mantener y publicar contenido
              sin depender de un desarrollador para cada actualización.
            </p>

            <div class="mt-10 flex flex-wrap gap-3">
              <a
                href="https://daleskate.com/"
                target="_blank"
                rel="noreferrer"
                class="group inline-flex items-center gap-3 rounded-full bg-foreground px-6 py-3 text-sm font-medium text-background transition-all duration-300 hover:bg-accent"
              >
                Visitar Dale Skate

                <span
                  class="transition-transform duration-300 group-hover:-translate-y-0.5 group-hover:translate-x-0.5"
                  aria-hidden="true"
                >
                  ↗
                </span>
              </a>

              <a
                href="https://github.com/raychavezdev/daleskate"
                target="_blank"
                rel="noreferrer"
